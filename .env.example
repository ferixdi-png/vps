# Ferixdi VPN Telegram bot
BOT_TOKEN=
ADMIN_IDS=
TRIAL_DAYS=3
SUPPORT=@ferixdiii

# Public subscription endpoint
# If empty, bot reads IP from /root/FERIXDI-NODE-INFO.txt
PUBLIC_HOST=
SUB_PORT=8080

# Local Xray node managed by the bot
XRAY_CONFIG=/opt/ferixdi/node/xray-config.json
XRAY_CONTAINER=ferixdi-xray
NODE_INFO=/root/FERIXDI-NODE-INFO.txt
DB_PATH=/opt/ferixdi/data/bot.db

# Optional future multi-node management values
VPN_API_TOKEN=
SUBSCRIPTION_SIGNING_SECRET=
